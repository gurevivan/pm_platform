# ============================================================
# PM Platform — шаблон переменных окружения для Docker
#
# Инструкция:
#   1. Скопируйте этот файл: cp backend/.env.example backend/.env
#   2. Или запустите setup.sh — он сделает это автоматически
# ============================================================

# --- Безопасность ---
# ОБЯЗАТЕЛЬНО замените на случайную строку (setup.sh делает это автоматически)
DJANGO_SECRET_KEY=change-me-generate-with-setup-sh

# --- Режим работы ---
# 0 = production (для Docker)  |  1 = разработка (для dev.sh)
DJANGO_DEBUG=0

# Среда запуска
DJANGO_ENV=production

# Хосты, которым разрешено обращаться к API.
# Укажите IP-адрес вашего сервера или домен (через запятую).
# Пример для локального компьютера: localhost,127.0.0.1
# Пример для сервера:               192.168.1.100
# Пример с доменом:                 example.com,www.example.com
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# --- База данных PostgreSQL ---
# В Docker POSTGRES_HOST — это имя контейнера (pm_db), не localhost!
USE_POSTGRES=1
POSTGRES_DB=pm_platform
POSTGRES_USER=pm
POSTGRES_PASSWORD=pm
POSTGRES_HOST=pm_db
POSTGRES_PORT=5432

# --- JWT токены ---
# Время жизни токена доступа в минутах
JWT_ACCESS_MINUTES=60

# --- CORS и CSRF ---
# Адрес фронтенда. В Docker nginx слушает на порту 80.
# Для локального компьютера: http://localhost
# Для сервера с IP:          http://192.168.1.100
# Для домена:                https://example.com
CORS_ALLOWED_ORIGINS=http://localhost
CSRF_TRUSTED_ORIGINS=http://localhost

# --- HTTPS ---
# Оставьте 0, если у вас нет SSL/TLS-сертификата (обычный HTTP).
# Установите 1 только если настроили HTTPS через nginx с сертификатом.
SECURE_SSL_REDIRECT=0
